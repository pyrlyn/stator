{
  "minTokens": 50,
  "minLines": 5,
  "mode": "strict",
  "crossFormats": "js-ts",
  "reporters": ["ai"],
  "ignore": [
    "**/.claude/worktrees/**",
    "**/.moon/cache/**",
    ".cache/**",
    "**/node_modules/**",
    "**/dist/**",
    "coverage/**",
    "packages/runtime/build*/**",
    "packages/runtime/vendor/**",
    "packages/tests/**",
    "packages/runtime/tests/**",
    "**/*.test.ts",
    "docs/architecture/**",
    "docs/brand/**",
    "site/**"
  ],
  "format": ["typescript", "tsx", "javascript", "c", "zig"],
  "ignoreIdentifiers": true,
  "ignorePattern": [
    "(?m)^(pub[ \\t]+)?const[ \\t]+[A-Za-z_][A-Za-z0-9_]*[ \\t]*=[ \\t]*(@import\\(\"[^\"\\n]*\"\\)|[A-Za-z_][A-Za-z0-9_]*)(\\.[A-Za-z_][A-Za-z0-9_]*)*;[ \\t]*$"
  ],
  "baseline": ".jscpd-baseline.json",
  "failOnNewClones": 0
}
