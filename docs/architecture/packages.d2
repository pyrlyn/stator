# Module dependencies — package view of plan.md §2.
# Arrows mean "imports from". Two invariants: ts.Type stops at frontend; mode stops at the gate.
# All src modules live in packages/compiler/; jsrt is packages/runtime/ (monorepo, plan-notes 204).
# std is packages/std/ (plan.md §11c T11.2): the compiler resolves and links it, never imports it.
# nodepkg is packages/node/ (plan.md §11c T11.6): resolved under --node only, strict TS over std.
# vitestator is packages/vite-stator/ (plan.md §11d T12.2): imports statorc/api; the compiler only
# loads it by name at run time, never imports it (plan §0.9).

...@theme

direction: right

cli: packages/compiler/src/cli
frontend: packages/compiler/src/frontend
support: "packages/compiler/src/support\ndiagnostics engine"
hir: "packages/compiler/src/hir\nHType + HIR + verifier"
lower: packages/compiler/src/lower
passes: packages/compiler/src/passes
codegen: packages/compiler/src/codegen
jsrt: {
  label: "packages/runtime/include/jsrt_value.h\n(mirrors docs/VALUE.md —\nthe codegen↔runtime contract)"
  shape: parallelogram
}
tsp: "typescript pkg"
std: {
  label: "packages/std\nstd/* surface (strict TS)\n+ Zig backings → libjsrt_std.a"
  shape: parallelogram
}
nodepkg: {
  label: "packages/node\nnode:* built-ins (strict TS)\nover std/*"
  shape: parallelogram
}

cli -> frontend
cli -> support
frontend -> hir
frontend -> support
frontend -> tsp
lower -> hir
lower -> support
passes -> hir
codegen -> hir
codegen -> jsrt: {
  style.stroke-dash: 3
  label: "emits C against"
}
frontend -> std: {
  style.stroke-dash: 3
  label: "resolves std/* to"
}
cli -> std: {
  style.stroke-dash: 3
  label: "links libjsrt_std.a\n(std importers only)"
}
frontend -> nodepkg: {
  style.stroke-dash: 3
  label: "resolves node:* to\n(--node only)"
}
nodepkg -> std
vitestator: {
  label: "packages/vite-stator\ndefault bundler adapter\n+ stator() Vite plugin"
  shape: parallelogram
}
vite: "vite pkg (peer)"
vitestator -> cli: "statorc/api"
vitestator -> vite
cli -> vitestator: {
  style.stroke-dash: 3
  label: "loads by name\n(--bundler=vite, js mode)"
}

std -> jsrt: {
  style.stroke-dash: 3
  label: "thread/sync boxed ABI\nZig primitives in libjsrt.a"
}
