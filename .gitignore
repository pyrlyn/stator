*.o
*.a
.DS_Store
/.serena
reasonix.toml
# moon's local task cache and run artifacts.
.moon/cache/
# Test impact map (plan.md §9 Task 6.17): machine-local, keyed to a commit, never committed.
.cache/
__pycache__/
*.pyc
packages/tests/differential/failures/
# Live fuzzer scratch: repo-local (the CLI resolves relative to the input), so lint and git both
# have to know it is transient -- otherwise `pnpm run ci` fails whenever a fuzzer run overlaps it.
.differential-*/
packages/tests/bench/results/
packages/tests/test262/corpus/
packages/tests/node-suite/corpus/
packages/tests/test262/results.json
# `--shard=N/M` writes one of these per shard; `--aggregate` merges them into results.json.
packages/tests/test262/results-*-of-*.json
packages/tests/test262/.tmp/
packages/tests/.asan-last-green.json
# examples/todo demo binaries (examples/todo/README.md builds ./todo-ts, ./todo-js).
/todo-ts
/todo-js

