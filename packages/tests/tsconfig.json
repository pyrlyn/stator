{
  "extends": "../compiler/tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // `packages/`, not `packages/tests/`: unit tests import the compiler modules they test, so the
    // program spans both packages. Nothing is emitted from this config, so rootDir only has to
    // contain the inputs.
    "rootDir": ".."
  },
  "include": ["**/*.ts"],
  "exclude": [
    "subset/subset_*",
    "subset/helper_*",
    "subset/cycle_partner_*",
    "golden/ts",
    "golden/js",
    "differential",
    // Concatenated raw into Test262 sources (Task 6.15). A type annotation here is a syntax error
    // in those tests, so the file stays annotation-free and out of this program.
    "test262/harness"
  ]
}
